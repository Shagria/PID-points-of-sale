@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix : <http://example.org/rules/> .
@prefix voc: <http://example.org/vocabulary/> .
@prefix schema: <http://schema.org/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# --- Points of sale mapping ---

:TriplesMap1 a rr:TriplesMap;
  rml:logicalSource [
    rml:source "pointsOfSale_transformed.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator "$[*]"
  ];

rr:subjectMap [
  rr:template "http://example.org/pointOfSale/{id}"
];

rr:predicateObjectMap [
  rr:predicate rdf:type;
  rr:objectMap [
   rr:constant schema:Place
 ]
];

rr:predicateObjectMap [
  rr:predicate schema:name;
  rr:objectMap [
    rml:reference "name";
      rr:language "cs"
  ]
];

rr:predicateObjectMap [
  rr:predicate schema:address;
  rr:objectMap [
    rml:reference "address";
      rr:language "cs"
  ]
];

rr:predicateObjectMap [
  rr:predicate geo:lat;
  rr:objectMap [
    rml:reference "lat";
      rr:datatype xsd:decimal
  ]
];

rr:predicateObjectMap [
  rr:predicate geo:long;
  rr:objectMap [
    rml:reference "lon";
      rr:datatype xsd:decimal
  ]
];

rr:predicateObjectMap [
    rr:predicate voc:pointType ;
    rr:objectMap [
      rr:template "http://example.com/pointType/{type}"
    ]
];

rr:predicateObjectMap [
    rr:predicate voc:payMethods ;
    rr:objectMap [
      rr:template "http://example.com/payMethods/{payMethodsExpanded[*]}"
    ]
];

rr:predicateObjectMap [
    rr:predicate voc:services ;
    rr:objectMap [
      rr:template "http://example.com/service/{servicesExpanded[*]}"
    ]
];

rr:predicateObjectMap [
  rr:predicate voc:pointType ;
  rr:objectMap [
    rr:parentTriplesMap :PointTypeMapping ;
    rr:joinCondition [
      rr:child "type" ;
      rr:parent "name"
    ]
  ]
];

rr:predicateObjectMap [
  rr:predicate voc:openingHours ;
  rr:objectMap [
    rr:parentTriplesMap :OpeningHoursMap ;
    rr:joinCondition [
      rr:child "id" ;
      rr:parent "parentId"
    ]
  ]
];

rr:predicateObjectMap [
  rr:predicate voc:pointType ;
  rr:objectMap [
    rr:parentTriplesMap :PointTypeMapping ;
    rr:joinCondition [
      rr:child "type" ;
      rr:parent "name"
    ]
  ]
].

# --- OPENING HOURS ---

:OpeningHoursMap a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "pointsOfSale_transformed.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[*].openingHours[*]"
];

rr:subjectMap [
    rr:termType rr:BlankNode
];

rr:predicateObjectMap [
  rr:predicate rdf:type;
  rr:objectMap [
   rr:constant schema:openingHoursSpecification
 ]
];

rr:predicateObjectMap [
    rr:predicate voc:parentId ;
    rr:objectMap [ rml:reference "parentId" ]
] ;

  rr:predicateObjectMap [
    rr:predicate voc:from ;
    rr:objectMap [ rml:reference "from" ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate voc:to ;
    rr:objectMap [ rml:reference "to" ]
  ] ;

    rr:predicateObjectMap [
    rr:predicate voc:note ;
    rr:objectMap [ rml:reference "note" ]
  ] ;

rr:predicateObjectMap [
  rr:predicate voc:timeInterval ;
  rr:objectMap [
    rr:parentTriplesMap :IntervalsMap ;
    rr:joinCondition [
      rr:child "parentId" ;
      rr:parent "parentId"
    ];
    rr:joinCondition [
      rr:child "from" ;
      rr:parent "from"
    ] ;
  ]
].


# --- HOUR INTERVALS ---

:IntervalsMap a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "pointsOfSale_transformed.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[*].openingHours[*].intervals[*]"
  ];

  rr:subjectMap [
    rr:termType rr:BlankNode
  ];

rr:predicateObjectMap [
  rr:predicate rdf:type;
  rr:objectMap [
   rr:constant voc:timeIntervals
 ]
];

  rr:predicateObjectMap [
    rr:predicate voc:from ;
    rr:objectMap [ rml:reference "from" ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate voc:parentId ;
    rr:objectMap [ rml:reference "parentId" ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate schema:opens ;
    rr:objectMap [ 
        rml:reference "opens" ;
        rr:datatype xsd:time
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate schema:closes ;
    rr:objectMap [ 
        rml:reference "closes" ;
        rr:datatype xsd:time
    ]
  ].